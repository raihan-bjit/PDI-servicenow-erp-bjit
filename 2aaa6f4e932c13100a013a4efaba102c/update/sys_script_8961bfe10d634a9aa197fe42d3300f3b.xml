        <script><![CDATA[
(function executeRule(current, previous) {
    var employee = current.getValue('employee');
    var startDate = current.getValue('start_date');
    var endDate = current.getValue('end_date');
    if (!employee || !startDate || !endDate) return;

    var gr = new GlideRecord('x_2316161_bjit_e_0_lv_app');
    gr.addQuery('employee', employee);
    gr.addQuery('status', 'NOT IN', 'rejected,cancelled');
    gr.addQuery('start_date', '<=', endDate);
    gr.addQuery('end_date', '>=', startDate);
    if (current.getValue('sys_id')) {
        gr.addQuery('sys_id', '!=', current.getValue('sys_id'));
    }
    gr.query();
    if (gr.next()) {
        gs.addErrorMessage('Overlapping leave application exists (' + gr.getValue('number') + '). Please check your existing applications.');
        current.setAbortAction(true);
    }
})(current, previous);
    ]]></script>
