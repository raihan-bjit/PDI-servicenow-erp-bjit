        <script><![CDATA[
(function executeRule(current, previous) {
    var checkIn = current.getValue('check_in');
    var checkOut = current.getValue('check_out');
    if (checkIn && checkOut) {
        var inParts = checkIn.split(':');
        var outParts = checkOut.split(':');
        var inMinutes = parseInt(inParts[0], 10) * 60 + parseInt(inParts[1], 10);
        var outMinutes = parseInt(outParts[0], 10) * 60 + parseInt(outParts[1], 10);
        var diffMinutes = outMinutes - inMinutes;
        if (diffMinutes < 0) diffMinutes += 1440;
        var hours = (diffMinutes / 60).toFixed(2);
        current.setValue('working_hours', hours);
    }
})(current, previous);
    ]]></script>
