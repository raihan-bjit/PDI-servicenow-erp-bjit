        <script><![CDATA[
(function executeRule(current, previous) {
    var employee = current.getValue('employee');
    var date = current.getValue('date');
    if (employee && date) {
        var gr = new GlideRecord('x_2316161_bjit_e_0_attend');
        gr.addQuery('employee', employee);
        gr.addQuery('date', date);
        gr.query();
        if (gr.next()) {
            gs.addErrorMessage('An attendance record already exists for this employee on ' + date + '. Please use attendance correction instead.');
            current.setAbortAction(true);
        }
    }
})(current, previous);
