        <script><![CDATA[
(function executeRule(current, previous) {
    var status = current.getValue('employment_status');
    var terminationDate = current.getValue('termination_date');

    if (terminationDate && status !== 'terminated' && status !== 'resigned' && status !== 'retired') {
        gs.addErrorMessage('Termination date can only be set when employment status is Terminated, Resigned, or Retired.');
        current.setValue('termination_date', '');
    }

    if ((status === 'terminated' || status === 'resigned') && !terminationDate) {
        gs.addInfoMessage('Please set a termination date for this employee.');
    }
})(current, previous);
    ]]></script>
