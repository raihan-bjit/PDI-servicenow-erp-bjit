        <script><![CDATA[
(function executeRule(current, previous) {
    var status = current.getValue('employment_status');
    var previousStatus = previous.getValue('employment_status');

    if (status !== previousStatus) {
        var userId = current.getValue('user');
        if (userId) {
            var userGr = new GlideRecord('sys_user');
            if (userGr.get(userId)) {
                if (status === 'terminated' || status === 'resigned' || status === 'retired') {
                    userGr.setValue('active', false);
                    userGr.update();
                } else if (status === 'active' && (previousStatus === 'terminated' || previousStatus === 'resigned' || previousStatus === 'retired')) {
                    userGr.setValue('active', true);
                    userGr.update();
                }
            }
        }
    }
})(current, previous);
    ]]></script>
