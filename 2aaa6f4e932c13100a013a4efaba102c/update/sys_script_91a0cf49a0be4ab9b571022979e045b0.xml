        <script><![CDATA[
(function executeRule(current, previous) {
    var checkIn = current.getValue('check_in');
    if (!checkIn) return;

    var configGr = new GlideRecord('x_2316161_bjit_e_0_att_cfg');
    configGr.addQuery('active', true);
    configGr.setLimit(1);
    configGr.query();
    if (!configGr.next()) return;

    var workStart = configGr.getValue('work_start');
    var gracePeriod = parseInt(configGr.getValue('grace_period') || '0', 10);

    if (workStart) {
        var startParts = workStart.split(':');
        var inParts = checkIn.split(':');
        var startMinutes = parseInt(startParts[0], 10) * 60 + parseInt(startParts[1], 10);
        var inMinutes = parseInt(inParts[0], 10) * 60 + parseInt(inParts[1], 10);
        current.setValue('is_late', inMinutes > (startMinutes + gracePeriod));
    }
})(current, previous);
    ]]></script>
